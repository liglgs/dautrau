# Chế độ dữ liệu: mock (mặc định) hoặc api (gọi backend FastAPI thật)
NEXT_PUBLIC_VIGILENS_DATA_MODE=mock

# --- Biến máy chủ: KHÔNG dùng tiền tố NEXT_PUBLIC_ để token không lọt vào bundle trình duyệt ---
# Địa chỉ backend FastAPI mà cầu nối /api/backend/* gọi tới.
VIGILENS_API_BASE=http://127.0.0.1:8000
# API mặc định dùng cookie session. Nhập token backend tại /login để tạo phiên.
NEXT_PUBLIC_VIGILENS_AUTH_MODE=session

# Chỉ cho demo/test local: đổi AUTH_MODE=token để dùng công tắc vai trò.
# Chế độ token không cung cấp phân quyền bằng phiên đăng nhập.
VIGILENS_INVESTIGATOR_TOKEN=inv-token
VIGILENS_REVIEWER_TOKEN=rev-token
