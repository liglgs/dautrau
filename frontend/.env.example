# Chế độ dữ liệu: mock (mặc định) hoặc api (gọi backend FastAPI thật)
NEXT_PUBLIC_VIGILENS_DATA_MODE=mock

# --- Biến máy chủ: KHÔNG dùng tiền tố NEXT_PUBLIC_ để bí mật không lọt vào bundle trình duyệt ---
# Địa chỉ backend FastAPI mà cầu nối /api/backend/* gọi tới.
VIGILENS_API_BASE=http://127.0.0.1:8000

# Cầu nối chỉ chuyển tiếp danh tính đã xác thực: cookie phiên `session_id` (chế độ nội bộ) hoặc
# header `Authorization` (chế độ Supabase). Trình duyệt không gửi vai, và cầu nối không tự chọn
# vai hay gắn token vai trò — xem AUTH-01.
#
# Tài khoản để đăng nhập do `scripts/auth_cli.py create-user` tạo, không nằm trong tệp này.
