{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigilens.local/contracts/hospital-v2/schemas.json",
  "title": "VigiLens hospital v2 — hợp đồng lát cắt DI (đề xuất, additive)",
  "description": "Lược đồ cho 7 thực thể của lát cắt DI: RequestContext, WorkItem, InvestigationLink, EvidenceBundle, ProfessionalResponse, FollowUp, VersionRef/ReviewRef. Trạng thái công việc, trạng thái chạy agent và trạng thái duyệt là ba trường riêng. Trường 'unknown' không bao giờ tự thành 'match'. Lỗi nguồn không bao giờ thành 'no results'.",
  "x-contract-status": "proposed_not_implemented",
  "x-contract-version": "hospital-v2.2026-10-06",
  "x-compatibility": "additive: không đổi schema MVP hiện có (src/models/schemas.py); mọi trường mới nằm trong namespace /api/v2.",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339, luôn có múi giờ."
    },
    "Actor": {
      "type": "object",
      "title": "Actor",
      "description": "Người dùng đã xác thực. Máy chủ lấy từ token, không lấy từ body.",
      "required": [
        "id",
        "role"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "role": {
          "enum": [
            "doctor",
            "pharmacist",
            "nurse",
            "reviewer",
            "admin",
            "service"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        }
      }
    },
    "WorkStatus": {
      "title": "WorkStatus",
      "description": "Vòng đời nghiệp vụ của yêu cầu. Tách khỏi trạng thái chạy agent và trạng thái duyệt.",
      "enum": [
        "draft",
        "accepted",
        "in_progress",
        "awaiting_information",
        "awaiting_review",
        "completed",
        "cancelled"
      ]
    },
    "RunStatusRef": {
      "title": "RunStatusRef",
      "description": "Bản sao trạng thái chạy agent gần nhất; phản chiếu RunStatus của MVP và thêm not_started.",
      "enum": [
        "not_started",
        "queued",
        "running",
        "waiting_for_review",
        "completed",
        "cancelled",
        "interrupted",
        "failed"
      ]
    },
    "ReviewStatusRef": {
      "title": "ReviewStatusRef",
      "description": "Trạng thái duyệt chuyên môn; not_required khi yêu cầu không cần duyệt.",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected",
        "changes_requested"
      ]
    },
    "ScopeField": {
      "type": "object",
      "title": "ScopeField",
      "description": "Một trường phạm vi. 'unknown' là giá trị hợp lệ và không được tự suy diễn thành giá trị khác.",
      "required": [
        "value",
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "resolution": {
          "enum": [
            "confirmed",
            "candidate",
            "unknown"
          ]
        },
        "source": {
          "enum": [
            "requester",
            "dictionary",
            "agent",
            "reviewer",
            "unknown"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "UnknownField": {
      "type": "object",
      "title": "UnknownField",
      "required": [
        "field",
        "reason",
        "needs_confirmation"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 80
        },
        "reason": {
          "type": "string",
          "maxLength": 300
        },
        "needs_confirmation": {
          "type": "boolean"
        },
        "asked_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "CoverageReport": {
      "type": "object",
      "title": "CoverageReport",
      "description": "Mức bao phủ bằng chứng. 'sources_error' khác 'sources_empty': lỗi không phải bằng chứng vắng.",
      "required": [
        "documents_retrieved",
        "sources_ok",
        "sources_empty",
        "sources_error",
        "abstract_only"
      ],
      "additionalProperties": false,
      "properties": {
        "documents_retrieved": {
          "type": "integer",
          "minimum": 0
        },
        "sources_ok": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources_empty": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources_error": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abstract_only": {
          "type": "boolean"
        },
        "full_text_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        }
      }
    },
    "SourceError": {
      "type": "object",
      "title": "SourceError",
      "required": [
        "source",
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 60
        },
        "code": {
          "type": "string",
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "Gap": {
      "type": "object",
      "title": "Gap",
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "no_results",
            "missing_evidence",
            "missing_source",
            "scope_mismatch",
            "contradiction",
            "ambiguity",
            "source_error",
            "not_readable"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      }
    },
    "RequestContext": {
      "type": "object",
      "title": "RequestContext",
      "description": "Bối cảnh tiếp nhận: ai hỏi, hỏi gì, từ hệ thống nào. Không chứa dữ liệu bệnh nhân định danh.",
      "required": [
        "request_id",
        "requester",
        "channel",
        "received_at",
        "raw_text",
        "language"
      ],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "requester": {
          "$ref": "#/$defs/Actor"
        },
        "channel": {
          "enum": [
            "web",
            "api",
            "import",
            "email"
          ]
        },
        "received_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "raw_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "language": {
          "enum": [
            "vi",
            "en"
          ]
        },
        "source_system": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 80
            },
            "record_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "deidentified": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "deidentified"
          ]
        },
        "attachments": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "file",
                  "url",
                  "text"
                ]
              },
              "ref": {
                "type": "string",
                "maxLength": 500
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "WorkItem": {
      "type": "object",
      "title": "WorkItem",
      "description": "Yêu cầu điều tra. Ba trạng thái tách biệt: work_status (nghiệp vụ), run_status (agent), review_status (duyệt).",
      "required": [
        "work_item_id",
        "version",
        "context",
        "question",
        "scope",
        "unknowns",
        "priority",
        "work_status",
        "run_status",
        "review_status",
        "investigation_ids",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "work_item_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Dùng cho If-Match; mỗi lần ghi tăng 1."
        },
        "etag": {
          "type": "string",
          "maxLength": 120
        },
        "context": {
          "$ref": "#/$defs/RequestContext"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drug",
            "event"
          ],
          "properties": {
            "drug": {
              "$ref": "#/$defs/ScopeField"
            },
            "event": {
              "$ref": "#/$defs/ScopeField"
            },
            "population": {
              "$ref": "#/$defs/ScopeField"
            },
            "route": {
              "$ref": "#/$defs/ScopeField"
            },
            "dose": {
              "$ref": "#/$defs/ScopeField"
            },
            "time_window": {
              "$ref": "#/$defs/ScopeField"
            },
            "indication": {
              "$ref": "#/$defs/ScopeField"
            },
            "comparator": {
              "$ref": "#/$defs/ScopeField"
            }
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnknownField"
          }
        },
        "priority": {
          "enum": [
            "routine",
            "urgent",
            "stat"
          ]
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "work_status": {
          "$ref": "#/$defs/WorkStatus"
        },
        "run_status": {
          "$ref": "#/$defs/RunStatusRef"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatusRef"
        },
        "investigation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "response_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "follow_up_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "revision_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 80
          }
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "InvestigationLink": {
      "type": "object",
      "title": "InvestigationLink",
      "description": "Liên kết một yêu cầu với một lần chạy điều tra. Nhiều liên kết cho một yêu cầu là bình thường.",
      "required": [
        "link_id",
        "work_item_id",
        "investigation_id",
        "purpose",
        "state",
        "created_at",
        "created_by"
      ],
      "additionalProperties": false,
      "properties": {
        "link_id": {
          "$ref": "#/$defs/Identifier"
        },
        "work_item_id": {
          "$ref": "#/$defs/Identifier"
        },
        "investigation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "purpose": {
          "enum": [
            "initial",
            "additional",
            "recheck",
            "reproduce"
          ]
        },
        "state": {
          "$ref": "#/$defs/RunStatusRef"
        },
        "run_summary": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "steps_used": {
              "type": "integer",
              "minimum": 0
            },
            "documents_used": {
              "type": "integer",
              "minimum": 0
            },
            "source_requests_used": {
              "type": "integer",
              "minimum": 0
            },
            "stop_reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 60
            },
            "assessment_status": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 60
            }
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceError"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "created_by": {
          "$ref": "#/$defs/Actor"
        }
      }
    },
    "EvidenceItem": {
      "type": "object",
      "title": "EvidenceItem",
      "required": [
        "evidence_id",
        "doc_id",
        "source",
        "stance",
        "quote",
        "locator",
        "retrieval"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/Identifier"
        },
        "doc_id": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "maxLength": 60
        },
        "evidence_type": {
          "enum": [
            "rct",
            "observational",
            "case_report",
            "label",
            "faers_report",
            "review",
            "other"
          ]
        },
        "stance": {
          "enum": [
            "supports",
            "contradicts",
            "uncertain"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "locator": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            },
            "section": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            }
          }
        },
        "retrieval": {
          "enum": [
            "abstract_only",
            "full_text",
            "label_section",
            "warehouse_chunk"
          ]
        },
        "scope_match": {
          "enum": [
            "match",
            "mismatch",
            "unknown"
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    },
    "EvidenceBundle": {
      "type": "object",
      "title": "EvidenceBundle",
      "description": "Gói bằng chứng của một lần điều tra. Không có kết luận nhân quả.",
      "required": [
        "bundle_id",
        "work_item_id",
        "investigation_id",
        "created_at",
        "items",
        "gaps",
        "coverage",
        "assessment_status",
        "source_errors"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/Identifier"
        },
        "work_item_id": {
          "$ref": "#/$defs/Identifier"
        },
        "investigation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "claim": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "claim_text": {
              "type": "string",
              "maxLength": 1000
            },
            "drug": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "event": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            }
          },
          "required": [
            "claim_text"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceItem"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Gap"
          }
        },
        "coverage": {
          "$ref": "#/$defs/CoverageReport"
        },
        "assessment_status": {
          "enum": [
            "supported_for_scope",
            "contradicted_for_scope",
            "insufficient_evidence",
            "scope_mismatch",
            "out_of_scope",
            "requires_human_review"
          ]
        },
        "source_errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceError"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "ResponseSection": {
      "type": "object",
      "title": "ResponseSection",
      "required": [
        "key",
        "title",
        "text",
        "citations"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "enum": [
            "summary",
            "evidence",
            "limits",
            "recommendation",
            "follow_up"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "maxLength": 8000
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidence_id"
            ],
            "additionalProperties": false,
            "properties": {
              "evidence_id": {
                "$ref": "#/$defs/Identifier"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "ProfessionalResponse": {
      "type": "object",
      "title": "ProfessionalResponse",
      "description": "Phiếu trả lời chuyên môn. Draft không tự thành câu trả lời đã duyệt; chỉ review_status=approved mới được xuất chính thức.",
      "required": [
        "response_id",
        "work_item_id",
        "version",
        "status",
        "sections",
        "assessment_status",
        "coverage",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "response_id": {
          "$ref": "#/$defs/Identifier"
        },
        "work_item_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "etag": {
          "type": "string",
          "maxLength": 120
        },
        "status": {
          "enum": [
            "draft",
            "in_review",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ResponseSection"
          }
        },
        "assessment_status": {
          "enum": [
            "supported_for_scope",
            "contradicted_for_scope",
            "insufficient_evidence",
            "scope_mismatch",
            "out_of_scope",
            "requires_human_review"
          ]
        },
        "coverage": {
          "$ref": "#/$defs/CoverageReport"
        },
        "drafted_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "approved_at",
                "approved_by"
              ],
              "additionalProperties": false,
              "properties": {
                "approved_at": {
                  "$ref": "#/$defs/Timestamp"
                },
                "approved_by": {
                  "$ref": "#/$defs/Actor"
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 500
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "FollowUp": {
      "type": "object",
      "title": "FollowUp",
      "required": [
        "follow_up_id",
        "work_item_id",
        "kind",
        "status",
        "note",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "follow_up_id": {
          "$ref": "#/$defs/Identifier"
        },
        "work_item_id": {
          "$ref": "#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "request_information",
            "recheck_source",
            "monitor_case",
            "handover",
            "close"
          ]
        },
        "status": {
          "enum": [
            "open",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "due_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "closed_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "VersionRef": {
      "type": "object",
      "title": "VersionRef",
      "description": "Tham chiếu phiên bản để kiểm soát đồng thời; dùng cho If-Match và lịch sử.",
      "required": [
        "entity",
        "id",
        "version",
        "etag",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "entity": {
          "enum": [
            "work_item",
            "response",
            "evidence_bundle"
          ]
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "etag": {
          "type": "string",
          "maxLength": 120
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Actor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReviewRef": {
      "type": "object",
      "title": "ReviewRef",
      "required": [
        "review_id",
        "entity",
        "entity_id",
        "action",
        "reviewer",
        "decided_at",
        "previous_status",
        "new_status"
      ],
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "$ref": "#/$defs/Identifier"
        },
        "entity": {
          "enum": [
            "work_item",
            "response",
            "evidence_bundle"
          ]
        },
        "entity_id": {
          "$ref": "#/$defs/Identifier"
        },
        "entity_version": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "enum": [
            "approve",
            "reject",
            "request_changes",
            "edit_claim",
            "edit_evidence",
            "exclude_evidence",
            "request_more"
          ]
        },
        "reviewer": {
          "$ref": "#/$defs/Actor"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "decided_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "previous_status": {
          "type": "string",
          "maxLength": 40
        },
        "new_status": {
          "type": "string",
          "maxLength": 40
        }
      },
      "description": "Quyết định duyệt. Giá trị là superset additive của ReviewAction trong MVP: giữ nguyên các giá trị MVP và thêm 'request_changes' cho phiếu trả lời."
    },
    "ApiError": {
      "type": "object",
      "title": "ApiError",
      "description": "Envelope lỗi thống nhất của MVP: {\"error\": {code, message, details, request_id}}.",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "request_id"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "unauthorized",
                "forbidden",
                "not_found",
                "version_conflict",
                "idempotency_conflict",
                "runner_busy",
                "invalid_state",
                "budget_exhausted",
                "dossier_not_approved",
                "dossier_invalid",
                "source_error",
                "llm_format_error",
                "model_unavailable"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 500
            },
            "details": {
              "type": [
                "object",
                "null"
              ]
            },
            "request_id": {
              "$ref": "#/$defs/Identifier"
            }
          }
        }
      }
    },
    "WorkItemList": {
      "type": "object",
      "title": "WorkItemList",
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkItem"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
