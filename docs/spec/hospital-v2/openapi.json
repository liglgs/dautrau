              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "description": "Lỗi nguồn; gói bằng chứng ghi sources_error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas.json#/$defs/EvidenceBundle"
                },
                "examples": {
                  "default": {
                    "summary": "lỗi nguồn, không kết luận",
                    "$ref": "examples/evidence-bundle-source-error.json"
                  }
                }
              }
            }
          }
        }
      }
    },
