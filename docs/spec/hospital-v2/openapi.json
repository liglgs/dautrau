              "application/json": {
                "schema": {
                  "$ref": "schemas.json#/$defs/WorkItem"
                },
                "examples": {
                  "default": {
                    "summary": "đang chạy, đã gán chủ sở hữu",
                    "$ref": "examples/work-item-accepted.json"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateWorkItem",
        "summary": "Sửa câu hỏi/phạm vi, gán chủ sở hữu",
        "description": "Mỗi lần ghi tăng version. Sửa phạm vi tạo bản ghi mới với revision_of trỏ bản cũ; không ghi đè lịch sử.",
        "parameters": [
          {
            "$ref": "#/components/parameters/WorkItemId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schemas.json#/$defs/WorkItem"
              },
              "examples": {
                "default": {
                  "summary": "bản sửa phạm vi",
                  "$ref": "examples/work-item-accepted.json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bản đã sửa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas.json#/$defs/WorkItem"
                },
                "examples": {
                  "default": {
                    "summary": "đang chạy, đã gán chủ sở hữu",
                    "$ref": "examples/work-item-accepted.json"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/VersionConflict"
          },
          "422": {
            "description": "Dữ liệu không hợp lệ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schemas.json#/$defs/ApiError"
                }
              }
            }
          }
        }
      }
    },
