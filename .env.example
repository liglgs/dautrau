# VMEC-03 & P-066 synthetic local demo. Copy to .env; .env is ignored by Git and Docker builds.
APP_ENV=development
APP_PORT=8001
APP_HOST=0.0.0.0

# Model transport: auto selects the custom Chat Completions proxy when both
# GEMINI_BASE_URL and GEMINI_API_KEY are present; otherwise OpenAI or Gemini.
# Explicit options: gemini, openai, openai_compatible, auto.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.5-flash-lite

# Gemini Native Keys (hỗ trợ cấu hình tối đa 8 key để tự động xoay vòng Round-Robin & failover khi chạm 429)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_BASE_URL=

# OpenAI / OpenAI-compatible proxy (tuỳ chọn)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# For a proxy on this Windows host, set GEMINI_BASE_URL=http://localhost:8317.
# For Compose, explicitly set GEMINI_DOCKER_BASE_URL to reach the host proxy.
# GEMINI_DOCKER_BASE_URL=http://host.docker.internal:8317

# --- MVP điều tra an toàn thuốc (P-066) ---
# Khoá tĩnh dùng chung của giai đoạn ngoại tuyến, mặc định TẮT.
# Đây là khoá dùng chung chứ không phải danh tính, nên chỉ bật khi thật sự cần chạy ngoại tuyến.
# Tài khoản thật: scripts/auth_cli.py create-user  (xem docs/mvp-contracts.md).
# VIGILENS_ALLOW_LEGACY_TOKENS=1
INVESTIGATOR_TOKEN=
REVIEWER_TOKEN=
MVP_DB_PATH=data/mvp.sqlite3
# Optional Compose override when starting a restored database (container path):
# MVP_DB_PATH=/app/data/restored/mvp.sqlite3
# Opt-in Person 3 synthetic graph/API demo; sources and LLM stay mocked.
MVP_EVIDENCE_MODE=fixture
MVP_PERSON3_DEMO_SCENARIO=match
# Full Person 3 pipeline: MVP_EVIDENCE_MODE=person3 + MVP_SOURCE_MODE=live.
# Uses the configured model gateway; dictionary is limited to the five corpus families.
MVP_DICTIONARY_PATH=data/dictionaries/mvp_candidates_2026_10_02.json
# Fixture is offline. Live alone enables retrieval; select person3 for extraction.
MVP_SOURCE_MODE=fixture
# Used only with MVP_SOURCE_MODE=live. Local is explicit; API errors never select it.
MVP_PUBMED_MODE=api
MVP_PUBMED_CORPUS_ROOT=data/pubmed-local
MVP_SNAPSHOT_ROOT=data/snapshots
MVP_SOURCE_MAX_DOCUMENTS=5

# Origin được phép gọi API (phân tách bằng dấu phẩy). Mặc định đã gồm cả Vite (5173),
# Next.js app-router (3000), và Vigilens (3100).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# Leave blank for the local defaults (demo12345 / medreview); set strong values
# before any shared demo. Compose and the seed script use the same password.
DEMO_PASSWORD=
POSTGRES_PASSWORD=
SESSION_COOKIE_SECURE=false
RESEARCH_TOKEN=

# Optional verified rates for benchmark USD estimates and --max-cost-usd.
# MODEL_INPUT_USD_PER_MILLION=
# MODEL_OUTPUT_USD_PER_MILLION=

# Direct host execution defaults to PostgreSQL on localhost. Override if needed.
# DATABASE_URL=postgresql+psycopg://medreview:medreview@localhost:5432/medreview

# --- Kho ELT + RAG (P-066, vòng 2) ---
# PostgreSQL riêng cho ELT, tách khỏi cụm VMEC. Chạy: docker compose -f docker-compose.elt.yml up -d --wait
ELT_DATABASE_URL=postgresql+psycopg://medreview:medreview@localhost:5433/vigilens_elt
ELT_DB_PORT=5433
ELT_DB_NAME=vigilens_elt
# ChromaDB: thư mục lưu vector, tên bộ sưu tập, nhà cung cấp vector (auto|gemini|hash).
RAG_ENABLED=true
RAG_CHROMA_DIR=./data/chroma
RAG_COLLECTION=vigilens_docs
RAG_EMBEDDING_PROVIDER=auto
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=6
# PubMed tăng hạn mức khi có khóa NCBI (tùy chọn, không bắt buộc).
# NCBI_API_KEY=
# NCBI_EMAIL=
